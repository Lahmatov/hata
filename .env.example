# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:AA...
# Several recipients: comma-separated, e.g. 123456789,987654321 (each must press Start in the bot first)
TELEGRAM_CHAT_ID=123456789
ANTHROPIC_API_KEY=sk-ant-...
# Optional: traffic-aware commute via Google Routes API (otherwise OSRM x MORNING_TRAFFIC_FACTOR)
GOOGLE_MAPS_API_KEY=
MORNING_TRAFFIC_FACTOR=1.5
# Optional: override school coordinates (default: 38.735766, -9.226091)
SCHOOL_LAT=
SCHOOL_LON=
# Optional: official idealista API (apply at https://developers.idealista.com/access-request)
IDEALISTA_API_KEY=
IDEALISTA_API_SECRET=
IDEALISTA_RADIUS_M=9000
IDEALISTA_MONTHLY_QUOTA=90
